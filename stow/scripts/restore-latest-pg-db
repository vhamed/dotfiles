#!/bin/bash
set -euo pipefail

# Usage: restore-latest-postgres-db.sh <db_user> <db_name> [backups_dir]
DB_USER="${1:-}"
DB_NAME="${2:-}"
BACKUPS_DIR="${3:-./backup}"
DB_CONTAINER_NAME="db"

if [ -z "$DB_USER" ] || [ -z "$DB_NAME" ]; then
  echo "Usage: $0 <db_user> <db_name> [backups_dir]" >&2
  exit 2
fi

# simple compose file presence check
if [ ! -f docker-compose.yml ] && [ ! -f docker-compose.yaml ] && [ ! -f compose.yml ] && [ ! -f compose.yaml ]; then
  echo "Error: docker-compose file not found in current directory." >&2
  exit 3
fi

BACKUPS_DIR="$(eval echo "$BACKUPS_DIR")"
if [ ! -d "$BACKUPS_DIR" ]; then
  echo "Error: backups dir '$BACKUPS_DIR' not found." >&2
  exit 4
fi

LATEST_FILE="$(ls -t "$BACKUPS_DIR"/*.{sql.gz,dump.gz} 2>/dev/null | head -n1 || true)"
if [ -z "$LATEST_FILE" ] || [ ! -f "$LATEST_FILE" ]; then
  echo "No backup file found in $BACKUPS_DIR" >&2
  exit 5
fi

echo "Found backup: $LATEST_FILE"

# ensure db service reachable
if ! docker compose ps $DB_CONTAINER_NAME >/dev/null 2>&1; then
  echo "Error: 'db' service not available via docker compose. Ensure service named '$DB_CONTAINER_NAME' is running." >&2
  exit 6
fi

# Ensure database container is running
docker compose up -d db

echo "Dropping and recreating database '$DB_NAME'..."

docker compose exec db \
  psql -U "$DB_USER" -d postgres \
  -c "SELECT pg_terminate_backend(pid)
      FROM pg_stat_activity
      WHERE datname = '$DB_NAME'
      AND pid <> pg_backend_pid();" || true

docker compose exec db \
  psql -U "$DB_USER" -d postgres \
  -c "DROP DATABASE IF EXISTS \"$DB_NAME\";"

docker compose exec db \
  psql -U "$DB_USER" -d postgres \
  -c "CREATE DATABASE \"$DB_NAME\";"

echo "Restoring '$LATEST_FILE'..."

gunzip -c "$LATEST_FILE" > /tmp/backup.sql

docker compose cp /tmp/backup.sql db:/tmp/backup.sql
docker compose exec -T db psql -U $DB_USER -d $DB_NAME < /tmp/backup.sql

rm /tmp/backup.sql

echo "Restore complete."
